name = "moonbit-community/tui"

version = "0.1.0"

import {
  "moonbit-community/displaytext@0.1.5",
  "moonbit-community/tty@0.5.0",
  "moonbitlang/async@0.22.4",
  "kawaz/grapheme@0.10.4",
  "moonbit-community/casefold@0.1.6",
  "moonbit-community/cmark@0.4.11",
}

readme = "README.md"

repository = "https://github.com/moonbit-community/tonyfettes-tui"

license = "Apache-2.0"

keywords = [ "tui", "terminal", "immediate-mode", "native" ]

description = "Immediate-mode terminal UI library for MoonBit native targets, built on moonbit-community/tty."

preferred_target = "native"
